# Copy this file to .env, then add your credentials locally. Do not commit .env.
# Jev is enabled only when a nonempty key is configured.
# TYPESAFE_API_KEY=replace-locally

# AI-native workflow planning and replies use OpenAI Responses.
# Both a key and an explicit supported model are required; no model is guessed.
# OPENAI_API_KEY=replace-locally
# OPENAI_PLANNER_MODEL=choose-an-available-responses-model
# Optional separate Decisions provider (account availability must be verified).
# OPENAI_DECISION_MODEL=choose-an-available-decisions-model
# Protected, ignored SQLite store. Parent directory must have Unix mode 700.
# REASSURE_WORKFLOW_DB=.local/workflows.sqlite3

# Required to inspect raw provider exchanges from the Operator view.
# Generate a private local value (at least 32 bytes); never share or commit it.
# REASSURE_OPERATOR_KEY=replace-locally-with-a-long-random-secret

# Include Rust panic backtraces in API process diagnostics.
RUST_BACKTRACE=1
