    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug unit tests in library 'jev_sample'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "test"
                ]
            }
        },
        {
            "name": "Debug executable 'api'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "build",
                    "--bin=api",
                    "--locked"
                ],
                "filter": {
                    "name": "api",
                    "kind": "bin"
                }
            },
            "cwd": "${workspaceFolder}",
            "env": {
